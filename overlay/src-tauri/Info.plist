<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- no Dock icon, no menu bar: the horse is the whole app -->
  <key>LSUIElement</key>
  <true/>
  <!-- the mic button: macOS asks once, with these words -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Лошадка слушает, пока горит кнопка микрофона, — чтобы вы могли наговорить вопрос Claude.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Лошадка превращает сказанное в текст вопроса для Claude.</string>
</dict>
</plist>
